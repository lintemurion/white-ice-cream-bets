rules_version = '2';

// Source for firestore.rules. scripts/build-rules.mjs replaces __ADMIN_EMAIL__
// with VITE_ADMIN_EMAIL from .env.local; tests substitute a test email.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        // build-rules.mjs writes the admin email lowercased; compare case-insensitively
        // to match the client's isAdminUser. get() keeps a token with no email from erroring.
        && request.auth.token.get('email', '').lower() == '__ADMIN_EMAIL__'
        && request.auth.token.email_verified == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasStatus(uid, status) {
      return exists(userPath(uid)) && get(userPath(uid)).data.status == status;
    }

    function isMemberUid(uid) {
      return hasStatus(uid, 'member');
    }

    // The admin is never a member, even if a member user doc exists for her uid.
    function isMember() {
      return signedIn() && !isAdmin() && isMemberUid(request.auth.uid);
    }

    function isPending() {
      return signedIn() && hasStatus(request.auth.uid, 'pending');
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberCount() {
      return get(groupPath()).data.memberCount;
    }

    function groupPath() {
      return /databases/$(database)/documents/group/main;
    }

    function membersPath() {
      return /databases/$(database)/documents/group/members;
    }

    // Every current member's uid as a map key, so one lookup checks a whole list of people.
    function memberUids() {
      return get(membersPath()).data.uids;
    }

    function joinPath(uid) {
      return /databases/$(database)/documents/joinRequests/$(uid);
    }

    function tallyPath(uid) {
      return /databases/$(database)/documents/joinRequests/$(uid)/tally/counts;
    }

    function ballotPath(uid, v) {
      return /databases/$(database)/documents/joinRequests/$(uid)/ballots/$(v);
    }

    function votersPath(uid, v) {
      return /databases/$(database)/documents/joinRequests/$(uid)/voters/$(v);
    }

    // The update touches only these fields.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // The new doc has exactly these fields.
    function hasExactly(keys) {
      return request.resource.data.keys().hasAll(keys)
        && request.resource.data.keys().hasOnly(keys);
    }

    // Trimmed, 1 to `max` chars. The client trims before writing.
    function validText(s, max) {
      return s is string && s == s.trim() && s.size() >= 1 && s.size() <= max;
    }

    function validName(n) {
      return validText(n, 30);
    }

    // True when doc `path` is created by this same batch.
    function createdNow(path) {
      return !exists(path) && existsAfter(path);
    }

    // ---------- Anonymous votes (join requests and anonymous bets) ----------
    // A vote is a batch of the voter's ballot, a voter mark, and the tally. Each doc's rule
    // checks the others with get/getAfter, so none can be written alone.

    // Field `field` of doc `path` moves by exactly `by` in this batch.
    function bumped(path, field, by) {
      return getAfter(path).data[field] == get(path).data[field] + by;
    }

    // On a tally update: field `field` moves by exactly `by`.
    function tallyMoved(field, by) {
      return request.resource.data[field] == resource.data[field] + by;
    }

    function otherOf(c, x, y) {
      return c == x ? y : x;
    }

    // A tally update (fields x and y) that follows the requester's ballot at `ballot`:
    // a new ballot moves its choice +1 and the other field not at all; a changed ballot
    // moves the new choice +1 and the old one -1. The ballot rule checks membership and status.
    function tallyFollowsBallot(ballot, x, y) {
      return onlyChanges([x, y]) && (
        (createdNow(ballot)
          && tallyMoved(getAfter(ballot).data.choice, 1)
          && tallyMoved(otherOf(getAfter(ballot).data.choice, x, y), 0))
        || (exists(ballot)
          && get(ballot).data.choice != getAfter(ballot).data.choice
          && tallyMoved(getAfter(ballot).data.choice, 1)
          && tallyMoved(get(ballot).data.choice, -1)));
    }

    // ---------- Group ----------

    // Holds only a count and a uid; the pending waiting screen needs memberCount.
    // Members may only admit: +1 and lastAdmitted moves to a uid that goes pending -> member
    // in this same batch. The users rule only lets a member promote with an approved
    // request and this exact +1, so memberCount stays honest.
    match /group/main {
      allow read: if isAdmin() || isPending() || isMember();
      allow write: if isAdmin();
      allow update: if isMember()
        && onlyChanges(['memberCount', 'lastAdmitted'])
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && request.resource.data.lastAdmitted is string
        && hasStatus(request.resource.data.lastAdmitted, 'pending')
        && getAfter(userPath(request.resource.data.lastAdmitted)).data.status == 'member';
    }

    // The member list: uids as keys, value true. Members may only add the uid admitted in
    // this same batch (group/main's lastAdmitted, going pending -> member). The users rule
    // in turn requires that key, so the list, memberCount, and statuses move together.
    match /group/members {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
      allow update: if isMember() && addingAdmitted();

      function addingAdmitted() {
        let x = getAfter(groupPath()).data.lastAdmitted;
        let uids = request.resource.data.uids;
        return onlyChanges(['uids'])
          && x is string
          && uids is map
          && uids.diff(resource.data.uids).affectedKeys() == [x].toSet()
          && uids[x] == true
          && get(userPath(x)).data.status == 'pending'
          && getAfter(userPath(x)).data.status == 'member';
      }
    }

    // ---------- Users ----------

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid) || isMember();
      // The admin's blanket write skips the admin's own uid, so the admin can never be voted in.
      allow write: if isAdmin() && !isSelf(uid);

      // Request to join, step 1 of 3 (with joinRequests/{uid} and its tally).
      allow create: if isSelf(uid) && !isAdmin()
        && hasExactly(['status', 'displayName', 'createdAt'])
        && request.resource.data.status == 'pending'
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        && createdNow(joinPath(uid));

      allow update: if
        // Display name: pending user or member edits only her own name.
        (isSelf(uid)
          && resource.data.status in ['pending', 'member']
          && onlyChanges(['displayName'])
          && validName(request.resource.data.displayName))
        // Approve: pending -> member alongside the request going open -> approved,
        // group/main gaining exactly one member recorded as this uid, and this uid
        // being added to group/members in this same batch.
        || (isMember()
          && onlyChanges(['status'])
          && resource.data.status == 'pending'
          && request.resource.data.status == 'member'
          && get(joinPath(uid)).data.status == 'open'
          && getAfter(joinPath(uid)).data.status == 'approved'
          && getAfter(groupPath()).data.memberCount == memberCount() + 1
          && getAfter(groupPath()).data.lastAdmitted == uid
          && !(uid in memberUids())
          && uid in getAfter(membersPath()).data.uids)
        // Reject: pending -> rejected alongside the request going open -> rejected.
        || (isMember()
          && onlyChanges(['status'])
          && resource.data.status == 'pending'
          && request.resource.data.status == 'rejected'
          && get(joinPath(uid)).data.status == 'open'
          && getAfter(joinPath(uid)).data.status == 'rejected');
    }

    // ---------- Join requests ----------

    // The admin's blanket write skips the admin's own uid, so the admin cannot open a request.
    match /joinRequests/{uid} {
      allow read: if isAdmin() || isSelf(uid) || isMember();
      allow write: if isAdmin() && !isSelf(uid);

      // Request to join, step 2 of 3. Denied once users/{uid} exists (rejected, former...).
      allow create: if isSelf(uid) && !isAdmin()
        && hasExactly(['displayName', 'status', 'voterCount', 'createdAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.voterCount == 0
        && request.resource.data.createdAt == request.time
        && !exists(userPath(uid))
        && getAfter(userPath(uid)).data.status == 'pending'
        && getAfter(userPath(uid)).data.displayName == request.resource.data.displayName
        && existsAfter(tallyPath(uid));

      allow update: if resource.data.status == 'open' && (
        // New vote: +1 alongside this voter's voters doc being created (whose rule in
        // turn requires the ballot, whose rule checks the tally and membership).
        (onlyChanges(['voterCount'])
          && request.resource.data.voterCount == resource.data.voterCount + 1
          && createdNow(votersPath(uid, request.auth.uid)))
        // Approve: strict yes majority of members before admission.
        || (isMember()
          && onlyChanges(['status'])
          && request.resource.data.status == 'approved'
          && get(tallyPath(uid)).data.yes * 2 > memberCount()
          && getAfter(userPath(uid)).data.status == 'member')
        // Reject: strict no majority.
        || (isMember()
          && onlyChanges(['status'])
          && request.resource.data.status == 'rejected'
          && get(tallyPath(uid)).data.no * 2 > memberCount()
          && getAfter(userPath(uid)).data.status == 'rejected'));

      // Who voted. Members only, never the applicant.
      match /voters/{v} {
        allow read: if isAdmin() || (!isSelf(uid) && isMember());
        allow write: if isAdmin() && !isSelf(uid) && !isSelf(v);
        allow create: if isSelf(v)
          && request.resource.data.keys().size() == 0
          && createdNow(ballotPath(uid, v));
      }

      // One ballot per member, id = her uid. Only she (and the admin) can read it.
      match /ballots/{v} {
        allow read: if isAdmin() || (isSelf(v) && !isSelf(uid));
        // The admin cannot vote, so no admin write to a ballot under the admin's own uid.
        allow write: if isAdmin() && !isSelf(uid) && !isSelf(v);

        // New vote: ballot + voters doc + voterCount +1 + chosen tally field +1.
        allow create: if isSelf(v) && isMember()
          && hasExactly(['choice'])
          && request.resource.data.choice in ['yes', 'no']
          && get(joinPath(uid)).data.status == 'open'
          && getAfter(joinPath(uid)).data.voterCount == get(joinPath(uid)).data.voterCount + 1
          && existsAfter(votersPath(uid, v))
          && bumped(tallyPath(uid), request.resource.data.choice, 1);

        // Changed vote: old choice -1, new choice +1 (the tally rule pins the rest).
        allow update: if isSelf(v) && isMember()
          && onlyChanges(['choice'])
          && request.resource.data.choice in ['yes', 'no']
          && request.resource.data.choice != resource.data.choice
          && get(joinPath(uid)).data.status == 'open'
          && bumped(tallyPath(uid), request.resource.data.choice, 1)
          && bumped(tallyPath(uid), resource.data.choice, -1);
      }

      // Hidden until decided or everyone has voted; never shown to the applicant.
      match /tally/counts {
        allow read: if isAdmin() || (!isSelf(uid) && isMember() && (
          get(joinPath(uid)).data.status != 'open'
          || get(joinPath(uid)).data.voterCount >= memberCount()));
        allow write: if isAdmin() && !isSelf(uid);

        // Request to join, step 3 of 3.
        allow create: if isSelf(uid) && !isAdmin()
          && request.resource.data == {'yes': 0, 'no': 0}
          && createdNow(joinPath(uid));

        // A vote by the requester: exactly one field +1 for a new ballot, or -1/+1 to
        // follow a changed ballot. The ballot rule checks membership and open status.
        allow update: if tallyFollowsBallot(ballotPath(uid, request.auth.uid), 'yes', 'no');
      }
    }

    // ---------- Bets ----------

    function betPath(betId) {
      return /databases/$(database)/documents/bets/$(betId);
    }

    function betTallyPath(betId) {
      return /databases/$(database)/documents/bets/$(betId)/tally/counts;
    }

    function betBallotPath(betId, v) {
      return /databases/$(database)/documents/bets/$(betId)/ballots/$(v);
    }

    // No one appears twice in list `l`.
    function noDups(l) {
      return l.toSet().size() == l.size();
    }

    // Lists `x` and `y` share no one.
    function disjoint(x, y) {
      return x.toSet().intersection(y.toSet()).size() == 0;
    }

    // The people on a bet: three duplicate-free, pairwise disjoint lists of at most 8 people.
    function validLineup(a, b, s) {
      return a is list && b is list && s is list
        && noDups(a) && noDups(b) && noDups(s)
        && disjoint(a, b) && disjoint(s, a) && disjoint(s, b)
        && a.size() + b.size() + s.size() <= 8;
    }

    // `after` is `before` with only `me` added or removed (others keep their order).
    function onlyMeChanged(before, after, me) {
      return after is list && after.removeAll([me]) == before.removeAll([me]);
    }

    // The status a proposed bet must take after a member move (src/model/bet.ts nextStatus):
    // void if side A is empty; active if both sides have people and all are confirmed.
    function nextStatus(a, b, c) {
      return a.size() == 0 ? 'void'
        : (b.size() > 0 && c.hasAll(a.concat(b))) ? 'active'
        : 'proposed';
    }

    // An anonymous bet that is open for votes.
    function anonVoting(betId) {
      return get(betPath(betId)).data.voteStyle == 'anonymous'
        && get(betPath(betId)).data.status == 'voting';
    }

    match /bets/{betId} {
      allow read: if isAdmin() || isMember();

      // The admin may edit or delete any bet, but never vote: no admin write leaves the
      // admin's own uid in votesA, votesB, or voters.
      allow create, update: if isAdmin() && !hasAdminVote();
      // Deleting an anonymous bet takes its tally in the same batch, so no orphan is left.
      allow delete: if isAdmin()
        && (resource.data.voteStyle != 'anonymous' || !existsAfter(betTallyPath(betId)));

      // Propose. The creator is on side A. Anonymous bets create their zero tally in this batch.
      allow create: if isMember() && proposing();

      // One named predicate per transition. The admin's mark paid is his blanket update.
      // Members never delete bets: leaving as the last on side A voids the bet instead.
      allow update: if isMember()
        && (moving() || callingIt() || votingOpen() || settlingOpen()
          || votingAnon() || settlingAnon() || markingPaid());

      function hasAdminVote() {
        let d = request.resource.data;
        return request.auth.uid in d.get('votesA', {})
          || request.auth.uid in d.get('votesB', {})
          || request.auth.uid in d.get('voters', {});
      }

      function proposing() {
        let d = request.resource.data;
        return hasExactly(['description', 'sideA', 'sideB', 'subjects', 'confirmed', 'paidBy',
            'stakeA', 'stakeB', 'voteStyle', 'status', 'winner', 'createdBy', 'createdAt',
            'votesA', 'votesB', 'voters', 'voterCount'])
          && validLineup(d.sideA, d.sideB, d.subjects)
          && request.auth.uid in d.sideA
          && d.createdBy == request.auth.uid
          && d.confirmed == [request.auth.uid]
          && d.paidBy == []
          // One read checks everyone named; a missing member list fails the propose.
          && memberUids().keys().hasAll(d.sideA.concat(d.sideB).concat(d.subjects))
          && validText(d.description, 2000)
          && validText(d.stakeA, 500)
          && validText(d.stakeB, 500)
          && d.voteStyle in ['open', 'anonymous']
          && d.status == 'proposed'
          && d.winner == null
          && d.votesA == {}
          && d.votesB == {}
          && d.voters == {}
          && d.voterCount == 0
          && d.createdAt == request.time
          // createdNow, not existsAfter: a leftover tally at this id must not be inherited.
          && (d.voteStyle == 'open' || createdNow(betTallyPath(betId)));
      }

      // Join, switch, leave, or I'm in, while proposed. Each list changes only by the mover's
      // own id; joining or switching onto a side also marks her in; subjects can't move;
      // confirmed holds only people on a side; and status is set to what the new lineup
      // demands (nextStatus), so the write that completes the bet makes it active and the
      // write that empties side A voids it.
      function moving() {
        let me = request.auth.uid;
        let o = resource.data;
        let a = request.resource.data.sideA;
        let b = request.resource.data.sideB;
        let c = request.resource.data.confirmed;
        return o.status == 'proposed'
          && onlyChanges(['sideA', 'sideB', 'confirmed', 'status'])
          && !(me in o.subjects)
          && onlyMeChanged(o.sideA, a, me)
          && onlyMeChanged(o.sideB, b, me)
          && onlyMeChanged(o.confirmed, c, me)
          && validLineup(a, b, o.subjects)
          && noDups(c)
          && a.concat(b).toSet().hasAll(c)
          && (!(me in a) || me in o.sideA || me in c)
          && (!(me in b) || me in o.sideB || me in c)
          && request.resource.data.status == nextStatus(a, b, c)
          && me in memberUids();
      }

      // Any member calls it: active -> voting, nothing else changes.
      function callingIt() {
        return onlyChanges(['status'])
          && resource.data.status == 'active'
          && request.resource.data.status == 'voting';
      }

      // Open vote: the voter adds, moves, or removes only her own key, ends up in at most
      // one map, and her value is exactly true. Bettors and the subject may vote.
      function votingOpen() {
        let me = request.auth.uid;
        let a = request.resource.data.votesA;
        let b = request.resource.data.votesB;
        return resource.data.voteStyle == 'open'
          && resource.data.status == 'voting'
          && onlyChanges(['votesA', 'votesB'])
          && a is map
          && b is map
          && a.diff(resource.data.votesA).affectedKeys().hasOnly([me])
          && b.diff(resource.data.votesB).affectedKeys().hasOnly([me])
          && !(me in a && me in b)
          && (!(me in a) || a[me] == true)
          && (!(me in b) || b[me] == true);
      }

      // Any member settles an open bet: voting -> settled with a strict majority for the
      // winner against the live member count. Only status and winner change.
      function settlingOpen() {
        let d = request.resource.data;
        return resource.data.voteStyle == 'open'
          && resource.data.status == 'voting'
          && onlyChanges(['status', 'winner'])
          && d.status == 'settled'
          && ((d.winner == 'A' && resource.data.votesA.size() * 2 > memberCount())
            || (d.winner == 'B' && resource.data.votesB.size() * 2 > memberCount()));
      }

      // Anonymous vote, bet side: voters gains exactly the voter's own key (value true) and
      // voterCount +1, alongside her ballot being created (whose rule checks the tally).
      function votingAnon() {
        let me = request.auth.uid;
        let v = request.resource.data.voters;
        return resource.data.voteStyle == 'anonymous'
          && resource.data.status == 'voting'
          && onlyChanges(['voters', 'voterCount'])
          && v is map
          && v.diff(resource.data.voters).affectedKeys().hasOnly([me])
          && !(me in resource.data.voters)
          && me in v
          && v[me] == true
          && request.resource.data.voterCount == resource.data.voterCount + 1
          && createdNow(betBallotPath(betId, me));
      }

      // Any member settles an anonymous bet: voting -> settled with a strict majority in the
      // pre-batch tally (get, not getAfter) against the live member count.
      function settlingAnon() {
        let d = request.resource.data;
        return resource.data.voteStyle == 'anonymous'
          && resource.data.status == 'voting'
          && onlyChanges(['status', 'winner'])
          && d.status == 'settled'
          && ((d.winner == 'A' && get(betTallyPath(betId)).data.A * 2 > memberCount())
            || (d.winner == 'B' && get(betTallyPath(betId)).data.B * 2 > memberCount()));
      }

      // The winner marks it paid: settled -> paid, nothing else changes.
      function markingPaid() {
        return onlyChanges(['status'])
          && resource.data.status == 'settled'
          && request.resource.data.status == 'paid'
          && ((resource.data.winner == 'A' && isSelf(resource.data.sideA))
            || (resource.data.winner == 'B' && isSelf(resource.data.sideB)));
      }

      // One ballot per member, id = her uid. Only she (and the admin) can read it.
      match /ballots/{v} {
        allow read: if isAdmin() || isSelf(v);
        // The admin cannot vote, so no admin write to a ballot under the admin's own uid.
        allow write: if isAdmin() && !isSelf(v);

        // New vote: ballot + voters key + voterCount +1 + chosen tally field +1.
        allow create: if isSelf(v) && isMember()
          && hasExactly(['choice'])
          && request.resource.data.choice in ['A', 'B']
          && anonVoting(betId)
          && getAfter(betPath(betId)).data.voterCount == get(betPath(betId)).data.voterCount + 1
          && v in getAfter(betPath(betId)).data.voters
          && bumped(betTallyPath(betId), request.resource.data.choice, 1);

        // Changed vote: old choice -1, new choice +1 (the tally rule pins the rest).
        allow update: if isSelf(v) && isMember()
          && onlyChanges(['choice'])
          && request.resource.data.choice in ['A', 'B']
          && request.resource.data.choice != resource.data.choice
          && anonVoting(betId)
          && bumped(betTallyPath(betId), request.resource.data.choice, 1)
          && bumped(betTallyPath(betId), resource.data.choice, -1);
      }

      // Hidden until decided or everyone has voted.
      match /tally/counts {
        allow read: if isAdmin() || (isMember() && (
          get(betPath(betId)).data.status in ['settled', 'paid', 'void']
          || get(betPath(betId)).data.voterCount >= memberCount()));
        allow write: if isAdmin();

        // A vote by the requester; the ballot rule checks membership and voting status.
        allow update: if tallyFollowsBallot(betBallotPath(betId, request.auth.uid), 'A', 'B');

        // Propose, anonymous: the zero tally is created with its bet in the same batch.
        allow create: if isMember()
          && request.resource.data == {'A': 0, 'B': 0}
          && createdNow(betPath(betId))
          && getAfter(betPath(betId)).data.voteStyle == 'anonymous'
          && getAfter(betPath(betId)).data.status == 'proposed';
      }
    }

    // Everything else is denied by default.
  }
}
